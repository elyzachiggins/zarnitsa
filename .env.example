# --- Credentials -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# --- Backbone routing ----------------------------------------------------------
# ZARNITSA_BACKBONE drives the four supporting personas (GRU, MO, NGSh, Sovbez).
# ZARNITSA_CINC_* optionally routes the Commander-in-Chief — the synthesis the user
# actually reads — to a stronger model. Leave the CINC vars unset to use one model
# everywhere.
#
# A deliberation is 5 calls at 6-8k max_tokens, so cost is dominated by OUTPUT price.
# Approximate cost per deliberation at ~66k in / ~18k out:
#   claude-opus-4-7                 ~$0.78
#   claude-haiku-4-5                ~$0.16   (no new provider code needed)
#   moonshotai/kimi-k2-thinking     ~$0.085
#   deepseek/deepseek-v3.2          ~$0.025
# Verify with `zarnitsa eval` rather than trusting these figures.
ZARNITSA_BACKBONE=anthropic
# ZARNITSA_CINC_BACKBONE=openrouter
# ZARNITSA_CINC_MODEL=moonshotai/kimi-k2-thinking

# Per-backbone default models
ZARNITSA_ANTHROPIC_MODEL=claude-opus-4-7
ZARNITSA_OPENROUTER_MODEL=deepseek/deepseek-v3.2
ZARNITSA_GEMINI_MODEL=gemini-2.5-pro
ZARNITSA_OLLAMA_MODEL=gemma3:27b
ZARNITSA_OLLAMA_HOST=http://localhost:11434

# Prompt caching on providers that support it (Anthropic). Pure cost optimisation.
ZARNITSA_PROMPT_CACHE=true

# --- Security ------------------------------------------------------------------
# Comma-separated shared secrets accepted on X-API-Key or Authorization: Bearer.
# LEAVING THIS EMPTY MAKES THE COUNCIL ENDPOINTS PUBLIC. Each request spends five
# model completions, so an unauthenticated public deployment is a way for strangers
# to spend your API budget in a loop.
ZARNITSA_API_KEYS=

# Comma-separated CORS origins. Narrow to the frontend origin in production.
ZARNITSA_ALLOWED_ORIGINS=*

# Council deliberations per caller per window. Set to 0 to disable.
ZARNITSA_RATE_LIMIT_REQUESTS=20
ZARNITSA_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Corpus --------------------------------------------------------------------
ZARNITSA_CORPUS_SNAPSHOT=2026-05
ZARNITSA_DATA_DIR=data
ZARNITSA_RETRIEVAL_TOP_K=6

# --- Server --------------------------------------------------------------------
ZARNITSA_HOST=127.0.0.1
ZARNITSA_PORT=8000

# Fidelity floor: "strict" refuses claims without corpus support;
# "permissive" allows model-extrapolation tagged outputs
ZARNITSA_FIDELITY_MODE=strict

# --- Grounding & verification ---------------------------------------------------
# Refuse (503) rather than return ungrounded analysis when the corpus can't load.
# A scenario that simply matches nothing is unaffected — that's a normal result.
ZARNITSA_REQUIRE_GROUNDING=true
# Lexical claim-support screen. Free and deterministic; see docs/operations.md for
# what it can and cannot establish.
ZARNITSA_VERIFY_CLAIMS=true

# --- Optional backends (all off by default) -------------------------------------
# "bm25" or "hybrid" (BM25 + multilingual embeddings). Hybrid needs .[offline].
ZARNITSA_RETRIEVAL_MODE=bm25
ZARNITSA_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Route through the LangGraph StateGraph instead of asyncio staging. Needs .[graph].
ZARNITSA_USE_LANGGRAPH=false
# Shared rate-limit window across workers. Needs .[redis]. Unset = in-process.
ZARNITSA_REDIS_URL=
